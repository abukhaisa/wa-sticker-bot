# ==========================================
# KONFIGURASI WHATSAPP STICKER BOT
# ==========================================

# Nama Bot
BOT_NAME="StickerCraft Bot"

# Nomor Super Owner Bot (Wajib diisi, tanpa '+' atau spasi, contoh: 6281234567890)
OWNER_NUMBER="6281234567890"

# Nomor Admin Tambahan (Pisahkan dengan koma jika lebih dari satu)
# Contoh: ADMIN_NUMBERS="628111111111,628222222222"
ADMIN_NUMBERS=""

# Prefix Perintah (. / ! / #)
PREFIX="."

# Metadata Stiker Default (EXIF)
STICKER_PACKNAME="StickerCraft Bot"
STICKER_AUTHOR="Created by Baileys"

# Anti-Banned & Cooldown untuk Member
USER_COOLDOWN_SEC=6
DAILY_LIMIT=40
MIN_DELAY_MS=1500
MAX_DELAY_MS=3500

# Port Web Server (Keep-Alive)
PORT=3000

# Opsional: URL deployment kamu untuk auto-ping (misal https://my-bot.onrender.com)
SELF_PING_URL=""

# Direktori Penyimpanan Sesi
SESSION_DIR="./auth_info"
