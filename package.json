{
  "name": "wa-sticker-bot",
  "version": "1.0.0",
  "description": "WhatsApp Sticker Generator Bot with Advanced Anti-Banned and 24/7 Keep-Alive",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "postinstall": "node -e \"const fs=require('fs');const p='node_modules/wa-sticker-formatter/dist/internal/crop.js';if(fs.existsSync(p)){let c=fs.readFileSync(p,'utf8');c=c.replace(/'-vsync',\\s*'0',?\\s*/g,'');fs.writeFileSync(p,c);}\""
  },
  "keywords": [
    "whatsapp",
    "baileys",
    "sticker-generator",
    "anti-ban",
    "keep-alive"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "node-cache": "^5.1.2",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.5",
    "wa-sticker-formatter": "^4.4.4"
  },
  "overrides": {
    "sharp": "^0.35.5"
  }
}
